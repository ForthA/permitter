<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>frth.permitter</groupId>
    <artifactId>permitter-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>permitter-plugin</artifactId>
  <name>Permitter javac Plugin</name>
  <description>Checks Java source against Permitter usage policies during compilation.</description>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Keep javac from loading this plugin from target/classes before it has been compiled. -->
          <compilerArgs>
            <arg>-processorpath</arg>
            <arg>${project.build.directory}/empty-processor-path</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
